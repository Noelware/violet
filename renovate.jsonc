// This is the Renovate configuration for Violet.
//
// Visit https://github.com/Noelware/.github/blob/master/default.json for the Renovate configuration
// for all repositories.
{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>Noelware/.github:default.jsonc"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["hack/build-ci-images.sh"],
            "matchStrings": [
                "#\\s*renovate:\\s*ref=(?<depName>\\S+):(?<currentValue>[^\\s\"]+)\\s*\\n\\s*\\w+\\[\"[^\"]*\"\\]=\"(?<currentDigest>sha256:[a-f0-9]{64})\""
            ],
            "datasourceTemplate": "docker"
        }
    ]
}
