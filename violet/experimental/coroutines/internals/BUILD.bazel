load("//buildsystem/bazel:cc.bzl", "violet_cc_library")

package(
    default_visibility = ["//visibility:public"],
)

violet_cc_library(
    name = "raw_task",
    hdrs = ["//include/violet/Experimental/Coroutines/Internals:RawTask.h"],
    copts = select({
        "@rules_cc//cc/compiler:gcc": ["-fcoroutines"],
        "//conditions:default": [],
    }),
    deps = [
        "//violet",
        "//violet:source_location",
    ],
)

violet_cc_library(
    name = "parker",
    srcs = ["//src/experimental/coroutines/internals:Parker.cc"],
    hdrs = ["//include/violet/Experimental/Coroutines/Internals:Parker.h"],
    deps = [
        "//violet/experimental:mutex",
        "//violet/experimental/time:instant",
    ],
)

violet_cc_library(
    name = "scheduler",
    srcs = ["//src/experimental/coroutines/internals:Scheduler.cc"],
    hdrs = ["//include/violet/Experimental/Coroutines/Internals:Scheduler.h"],
    copts = select({
        "@rules_cc//cc/compiler:gcc": ["-fcoroutines"],
        "//conditions:default": [],
    }),
    deps = [
        ":raw_task",
        ":spawned_task",
        "//violet/experimental/coroutines:waker",
        "//violet/experimental/time:clock",
    ],
)

violet_cc_library(
    name = "spawned_task",
    srcs = ["//src/experimental/coroutines/internals:SpawnedTask.cc"],
    hdrs = ["//include/violet/Experimental/Coroutines/Internals:SpawnedTask.h"],
    copts = select({
        "@rules_cc//cc/compiler:gcc": ["-fcoroutines"],
        "//conditions:default": [],
    }),
    deps = [
        ":raw_task",
        "//violet/experimental/coroutines:basic_awaiter",
        "//violet/experimental/coroutines:task",
    ],
)
