violet_cc_library(
    name = "iouring",
    srcs = ["//src/experimental/coroutines/internals/io/drivers:iouring.cc"],
    hdrs = ["//include/violet/Experimental/Coroutines/Internals/IO/Drivers:IoUring.h"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//violet/experimental:slice",
        "//violet/experimental/collections:hash_map",
        "//violet/experimental/coroutines/internals/io:driver",
        "//violet/experimental/coroutines/internals/io:op",
        "//violet/io/experimental:descriptor",
        "@liburing",
    ],
)

violet_cc_library(
    name = "kqueue",
    srcs = ["//src/experimental/coroutines/internals/io/drivers:kqueue.cc"],
    hdrs = ["//include/violet/Experimental/Coroutines/Internals/IO/Drivers:Kqueue.h"],
    target_compatible_with = [
        "@platforms//os:macos",
        # "@platforms//os:freebsd",
        # "@platforms//os:netbsd"
    ],
    deps = [
        "//violet/experimental/coroutines/internals/io:driver",
        "//violet/experimental/coroutines/internals/io:op",
    ],
)

violet_cc_library(
    name = "windows",
    srcs = ["//src/experimental/coroutines/internals/io/drivers:windows.cc"],
    hdrs = ["//include/violet/Experimental/Coroutines/Internals/IO/Drivers:Windows.h"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        "//violet/experimental/coroutines/internals/io:driver",
        "//violet/experimental/coroutines/internals/io:op",
    ],
)
