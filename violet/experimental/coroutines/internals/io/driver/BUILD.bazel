load("//buildsystem/bazel:cc.bzl", "violet_cc_library", "violet_cc_test")

package(
    default_visibility = ["//visibility:public"],
)

_IO = "//violet/experimental/coroutines/internals/io"

violet_cc_library(
    name = "driver",
    deps = select({
        _IO + ":use_epoll": [":epoll"],
        _IO + ":use_iocp": [":windows"],
        _IO + ":use_iouring": [":iouring"],
        _IO + ":use_kqueue": [":kqueue"],
        "//conditions:default": [],
    }),
)

violet_cc_test(
    name = "driver_test",
    srcs = ["//tests/experimental/coroutines/internals/io:Driver.test.cc"],
    deps = [
        ":driver",
        "//tests/experimental/coroutines/internals/io/fixtures:io_driver_test_fixture",
        "//violet/experimental/coroutines:io",
    ],
)

violet_cc_library(
    name = "epoll",
    srcs = ["//src/experimental/coroutines/internals/io/drivers:epoll.cc"],
    hdrs = ["//include/violet/Experimental/Coroutines/Internals/IO/Drivers:Epoll.h"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//violet/experimental:slice",
        "//violet/experimental/collections:hash_map",
        "//violet/experimental/coroutines/internals/io:driver",
        "//violet/experimental/coroutines/internals/io:op",
        "//violet/io/experimental:descriptor",
    ],
)

