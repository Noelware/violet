load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//buildsystem/bazel:cc.bzl", "violet_cc_library")

package(
    default_visibility = ["//visibility:public"],
)

_FLAG = "//buildsystem/bazel/flags:coroutines_io_driver_"

selects.config_setting_group(
    name = "default_epoll",
    match_all = [
        "@platforms//os:linux",
        _FLAG + "platform-dependent",
    ],
    visibility = ["//violet/experimental/coroutines/internals/io:__subpackages__"],
)

selects.config_setting_group(
    name = "default_kqueue",
    match_all = [
        "@platforms//os:macos",
        _FLAG + "platform-dependent",
    ],
    visibility = ["//violet/experimental/coroutines/internals/io:__subpackages__"],
)

selects.config_setting_group(
    name = "default_iocp",
    match_all = [
        "@platforms//os:windows",
        _FLAG + "platform-dependent",
    ],
    visibility = ["//violet/experimental/coroutines/internals/io:__subpackages__"],
)

selects.config_setting_group(
    name = "use_epoll",
    match_any = [
        _FLAG + "epoll",
        ":default_epoll",
    ],
    visibility = ["//violet/experimental/coroutines/internals/io:__subpackages__"],
)

selects.config_setting_group(
    name = "use_kqueue",
    match_any = [
        _FLAG + "kqueue",
        ":default_kqueue",
    ],
    visibility = ["//violet/experimental/coroutines/internals/io:__subpackages__"],
)

selects.config_setting_group(
    name = "use_iocp",
    match_any = [
        _FLAG + "iocp",
        ":default_iocp",
    ],
    visibility = ["//violet/experimental/coroutines/internals/io:__subpackages__"],
)

alias(
    name = "use_iouring",
    actual = _FLAG + "iouring",
    visibility = ["//violet/experimental/coroutines/internals/io:__subpackages__"],
)

cc_library(
    name = "features",
    defines = select({
        ":use_epoll": ["VIOLET_FEATURE_COROUTINES_IO_EPOLL_DRIVER"],
        ":use_iocp": ["VIOLET_FEATURE_COROUTINES_IO_IOCP_DRIVER"],
        ":use_iouring": ["VIOLET_FEATURE_COROUTINES_IO_URING_DRIVER"],
        ":use_kqueue": ["VIOLET_FEATURE_COROUTINES_IO_KQUEUE_DRIVER"],
        "//conditions:default": [],
    }),
    visibility = ["//violet/experimental/coroutines/internals/io:__subpackages__"],
)

violet_cc_library(
    name = "driver",
    hdrs = ["//include/violet/Experimental/Coroutines/Internals/IO:Driver.h"],
    deps = [
        "//violet/experimental:unique",
        "//violet/experimental/time:clock",
        "//violet/experimental/time:instant",
        "//violet/io/experimental:error",
    ],
)

violet_cc_library(
    name = "op",
    srcs = ["//src/experimental/coroutines/internals/io:Op.cc"] + select({
        ":use_iouring": ["//src/experimental/coroutines/internals/io/op:iouring.cc"],
        "//conditions:default": [],
    }),
    hdrs = ["//include/violet/Experimental/Coroutines/Internals/IO:Op.h"],
    deps = [
        ":features",
        "//violet/experimental/coroutines:waker",
        "//violet/io/experimental:descriptor",
    ] + select({
        ":use_iouring": ["@liburing"],
        "//conditions:default": [],
    }),
)
