load("//buildsystem/bazel:cc.bzl", "violet_cc_library", "violet_cc_test")

package(
    default_visibility = ["//visibility:public"],
)

violet_cc_library(
    name = "single_threaded",
    srcs = ["//src/experimental/coroutines/internals/schedulers:SingleThreadedScheduler.cc"],
    hdrs = ["//include/violet/Experimental/Coroutines/Internals/Schedulers:SingleThreadedScheduler.h"],
    copts = select({
        "@rules_cc//cc/compiler:gcc": ["-fcoroutines"],
        "//conditions:default": [],
    }),
    deps = [
        "//violet/experimental/coroutines/internals:parker",
        "//violet/experimental/coroutines/internals:scheduler",
    ],
)

violet_cc_test(
    name = "single_threaded_test",
    srcs = ["//tests/experimental/coroutines/internals:SingleThreadedScheduler.test.cc"],
    deps = [
        ":single_threaded",
        "//violet/experimental/coroutines:basic_awaiter",
        "//violet/experimental/coroutines:task",
    ],
)
