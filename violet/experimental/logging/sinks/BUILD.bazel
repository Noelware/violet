load("//buildsystem/bazel:cc.bzl", "violet_cc_library", "violet_cc_test")

package(
    default_visibility = ["//visibility:public"],
)

violet_cc_library(
    name = "console",
    srcs = select(
        {
            "@platforms//os:linux": ["//src/experimental/logging/sinks/console:unix.cc"],
            "@platforms//os:macos": ["//src/experimental/logging/sinks/console:unix.cc"],
            "@platforms//os:windows": ["//src/experimental/logging/sinks/console:windows.cc"],
        },
        no_match_error = "this platform doesn't support the Console sink",
    ),
    hdrs = ["//include/violet/Experimental/Logging/Sinks:Console.h"],
    deps = [
        "//violet/experimental:own",
        "//violet/experimental:synchronized",
        "//violet/experimental/logging:formatter",
        "//violet/experimental/logging:log_record",
        "//violet/experimental/logging:sink",
        "//violet/io/experimental:descriptor",
    ],
)

violet_cc_test(
    name = "console_unix_test",
    srcs = ["//tests/experimental/logging/sinks/console:Unix.test.cc"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":console",
        "//violet:strings",
        "//violet/experimental:slice",
    ],
)

violet_cc_library(
    name = "otel",
    srcs = ["//src/experimental/logging/sinks:OpenTelemetry.cc"],
    hdrs = ["//include/violet/Experimental/Logging/Sinks:OpenTelemetry.h"],
    defines = select({
        "//buildsystem/bazel/flags:otel_sink_enabled": [
            "VIOLET_FEATURE_EXPERIMENTAL_LOGGING_OTEL_SINK",
        ],
        "//conditions:default": [],
    }),
    deps = select({
        "//buildsystem/bazel/flags:otel_sink_enabled": [
            "//violet/experimental/logging:async_sink",
            "//violet/experimental/logging:batch_queue",
            "//violet/experimental/logging:log_record",
            "@otel//api",
            "@otel//sdk:headers",
        ],
        "//conditions:default": ["//violet:macros"],
    }),
)

violet_cc_test(
    name = "otel_test",
    srcs = ["//tests/experimental/logging/sinks:OpenTelemetry.test.cc"],
    target_compatible_with = select({
        "//buildsystem/bazel/flags:otel_sink_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":otel"] + select({
        "//buildsystem/bazel/flags:otel_sink_enabled": [
            "//violet/experimental:mutex",
        ],
        "//conditions:default": [],
    }),
)
